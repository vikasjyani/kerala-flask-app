# =============================================================================
#  .gitignore — Kerala Clean Cooking Flask app
#  Tracked = everything required to RUN the app on the server:
#    *.py, database/, templates/, static/, translations/ (.po + .mo),
#    requirements.txt, Procfile, gunicorn.conf.py, config.py, babel.cfg,
#    cooking_webapp.db (reference data) and user_data.db (empty schema).
#  Everything below is NOT needed to run and is excluded.
# =============================================================================

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
*.egg
*.egg-info/
dist/
build/
.eggs/

# ─── Virtual environments ─────────────────────────────────────────────────────
venv/
.venv/
.venv-docs/
env/
ENV/

# ─── Secrets & deploy keys (NEVER publish) ─────────────────────────────────────
.env
.env.*
!.env.example
.flask_secret
*.key
*.pem
*.ppk
*.pub
oracle_flaskkey.pub

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
application.log

# ─── Runtime / generated output ───────────────────────────────────────────────
uploads/
reports/
backups/
instance/
extra_research/

# ─── Node / migration tooling (not part of Flask app) ─────────────────────────
node-migration/

# ─── SQLite transient files (WAL / shared-memory / journal) ────────────────────
*.db-shm
*.db-wal
*.db-journal

# ─── Large data files (not source code) ───────────────────────────────────────
*.xlsx
*.xls

# ─── Jupyter notebooks ────────────────────────────────────────────────────────
*.ipynb
.ipynb_checkpoints/

# ─── Audit / review / dev docs & tools (not needed to run) ─────────────────────
AUDIT_REPORT.md
REMEDIATION_STATUS.md
DEPLOYMENT.md
PRESENTATION_SCRIPT.md
TECHNICAL_DEBUG_GUIDE.md
hostinger.md
render.yaml
review/
.audit_backup/
migrate_user_db.py

# ─── Local test / scratch artifacts ────────────────────────────────────────────
_smoke_user.db
*_report_*.pdf
Cooking_Report_*.pdf
_ml*.png
_rl*.png

# ─── OS files ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── IDEs ─────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# ─── Claude Code session data (local only) ────────────────────────────────────
.claude/

# NOTE: translations/**/*.mo ARE tracked — the server needs compiled catalogs.
#       cooking_webapp.db (reference data) and user_data.db (empty schema) ARE tracked.
